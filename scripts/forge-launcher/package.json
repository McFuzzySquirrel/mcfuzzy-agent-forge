{
  "name": "forge-launcher",
  "version": "1.0.0-beta.4",
  "type": "module",
  "description": "One command from zero to auto-build: creates a repo, bootstraps MyForge, captures your idea, and launches the full pipeline. Cross-platform replacement for the forge-launcher/bootstrap/forge-engine-run shell scripts.",
  "bin": {
    "forge-launcher": "./dist/cli.js"
  },
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json && node scripts/copy-client-assets.mjs",
    "test": "node --import tsx --test scripts/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check:version": "tsx scripts/version-consistency.ts",
    "prepack": "npm run build && node scripts/stage-resources.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cross-spawn": "^7.0.6",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
